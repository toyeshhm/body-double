AI_PROVIDER=muse

# Meta Model API (Muse): create a key under "API keys" at https://dev.meta.ai/ (keys start with LLM_)
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_TEXT_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0

# Gemini fallback: create a key at https://aistudio.google.com/apikey (image generation needs billing enabled)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Room store. Leave blank locally (rooms live in memory). Required on Vercel, where serverless
# instances share no memory: create a Supabase project, run supabase/migrations/*.sql, then paste
# the project URL and the service role (secret) key. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the address printed under the QR code. Defaults to the address the host page was opened on
# (or this machine's LAN address when you open it on localhost, so phones on the same Wi-Fi can join).
PUBLIC_URL=
