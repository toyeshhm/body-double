# muse (default) or gemini. "claude" is for local testing with no keys: text goes through the
# signed-in Claude Code CLI (CLAUDE_TEXT_MODEL, default haiku); images still need Muse or Gemini.
AI_PROVIDER=muse

# Meta Model API (Muse): create a key under "API keys" at https://dev.meta.ai/ (keys start with LLM_)
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_TEXT_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Gemini: create a key at https://aistudio.google.com/apikey. Called through the native API (x-goog-api-key),
# so "AQ." keys work. Gemini leads moderation and style profiles; Muse leads fakes, plans, recap, poster and
# voice; each falls back to the other. Text calls disable thinking (thinkingBudget 0): keep a 2.5 Flash model.
# Image generation needs billing enabled on the key (without it Gemini returns 429 and Muse paints the poster).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Room store + Wolf curve. Leave blank locally (rooms and votes live in memory). Required on Vercel,
# where serverless instances share no memory: create a free Tiger Cloud service (TimescaleDB) at
# https://console.cloud.timescale.com and paste its connection string. Tables, the vote hypertable and
# the curve's continuous aggregate are created on first request. Plain Postgres works too (no hypertable).
DATABASE_URL=

# Optional: the address printed under the QR code. Defaults to the address the host page was opened on
# (or this machine's LAN address when you open it on localhost, so phones on the same Wi-Fi can join).
PUBLIC_URL=
